<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_MessageDelivery" targetNamespace="https://github.com/rntgspr/alter-bridge/bpmn">
  <bpmn:message id="Message_CommitResult" name="CommitResult"/>
  <bpmn:message id="Message_SendRequest" name="SendRequest"/>
  <bpmn:message id="Message_InboxRequest" name="InboxRequest"/>
  <bpmn:message id="Message_AckRequest" name="AckRequest"/>
  <bpmn:message id="Message_Outcome" name="Outcome"/>
  <bpmn:message id="Message_Ping" name="Ping"/>
  <bpmn:message id="Message_Notice" name="Notice"/>
  <bpmn:message id="Message_Batch" name="Batch"/>
  <bpmn:message id="Message_AckResult" name="AckResult"/>
  <bpmn:dataStore id="EmbeddedStore" name="Embedded SurrealDB" isUnlimited="true"/>
  <bpmn:process id="Process_Codex" isExecutable="false">
    <bpmn:documentation>Sender device / Codex. Descriptive collaboration of current source behavior; runtime E2E is not claimed.</bpmn:documentation>
    <bpmn:startEvent id="Compose" name="Compose a message">
      <bpmn:outgoing>Seq_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="StableId" name="1. Create a stable&#10;message_id">
      <bpmn:incoming>Seq_0</bpmn:incoming>
      <bpmn:outgoing>Seq_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Send" name="2. MCP send&#10;actor + to + body + ID">
      <bpmn:incoming>Seq_1</bpmn:incoming>
      <bpmn:outgoing>Seq_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Committed" name="Commit result&#10;not recipient delivery">
      <bpmn:incoming>Seq_2</bpmn:incoming>
      <bpmn:outgoing>Seq_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_Committed" messageRef="Message_CommitResult"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="SendDone" name="Send committed">
      <bpmn:incoming>Seq_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Seq_0" sourceRef="Compose" targetRef="StableId"/>
    <bpmn:sequenceFlow id="Seq_1" sourceRef="StableId" targetRef="Send"/>
    <bpmn:sequenceFlow id="Seq_2" sourceRef="Send" targetRef="Committed"/>
    <bpmn:sequenceFlow id="Seq_3" sourceRef="Committed" targetRef="SendDone"/>
  </bpmn:process>
  <bpmn:process id="Process_Broker" isExecutable="false">
    <bpmn:documentation>Server / MCP + broker + embedded database. Descriptive collaboration of current source behavior; runtime E2E is not claimed.</bpmn:documentation>
    <bpmn:startEvent id="SendRequest" name="Receive MCP send">
      <bpmn:outgoing>Seq_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_SendRequest" messageRef="Message_SendRequest"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Authorize" name="3. Validate device&#10;and native actor">
      <bpmn:incoming>Seq_4</bpmn:incoming>
      <bpmn:outgoing>Seq_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Persist" name="4. Deduplicate / atomically&#10;commit room, message&#10;and notification">
      <bpmn:incoming>Seq_5</bpmn:incoming>
      <bpmn:outgoing>Seq_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="NewCommit" name="New commit?">
      <bpmn:incoming>Seq_6</bpmn:incoming>
      <bpmn:outgoing>Seq_7</bpmn:outgoing>
      <bpmn:outgoing>Seq_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Fork" name="">
      <bpmn:incoming>Seq_8</bpmn:incoming>
      <bpmn:outgoing>Seq_9</bpmn:outgoing>
      <bpmn:outgoing>Seq_10</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="CommitResult" name="Return committed result&#10;(new or identical retry)">
      <bpmn:incoming>Seq_7</bpmn:incoming>
      <bpmn:incoming>Seq_9</bpmn:incoming>
      <bpmn:outgoing>Seq_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="CommitReturned" name="">
      <bpmn:incoming>Seq_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Ping" name="5. WS Ping&#10;metadata only">
      <bpmn:incoming>Seq_10</bpmn:incoming>
      <bpmn:outgoing>Seq_12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="PingSent" name="">
      <bpmn:incoming>Seq_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="InboxRequest" name="Receive MCP inbox">
      <bpmn:outgoing>Seq_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_InboxRequest" messageRef="Message_InboxRequest"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="PureRead" name="Authorize actor; return&#10;unread batch + ACK positions&#10;NO consumption">
      <bpmn:incoming>Seq_13</bpmn:incoming>
      <bpmn:outgoing>Seq_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Batch" name="Return message bodies&#10;and ACK positions">
      <bpmn:incoming>Seq_14</bpmn:incoming>
      <bpmn:outgoing>Seq_15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="BatchReturned" name="">
      <bpmn:incoming>Seq_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="AckRequest" name="Receive MCP ack">
      <bpmn:outgoing>Seq_16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_AckRequest" messageRef="Message_AckRequest"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Consume" name="10. Validate membership;&#10;max-merge consumed cursor">
      <bpmn:incoming>Seq_16</bpmn:incoming>
      <bpmn:outgoing>Seq_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="AckResult" name="Return ACK result">
      <bpmn:incoming>Seq_17</bpmn:incoming>
      <bpmn:outgoing>Seq_18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="AckReturned" name="">
      <bpmn:incoming>Seq_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Outcome" name="Receive delivery frame">
      <bpmn:outgoing>Seq_19</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_Outcome" messageRef="Message_Outcome"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="RecordOutcome" name="Record ping_ack OR retry ping_fail&#10;Consumed cursor unchanged">
      <bpmn:incoming>Seq_19</bpmn:incoming>
      <bpmn:outgoing>Seq_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="OutcomeDone" name="">
      <bpmn:incoming>Seq_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Seq_4" sourceRef="SendRequest" targetRef="Authorize"/>
    <bpmn:sequenceFlow id="Seq_5" sourceRef="Authorize" targetRef="Persist"/>
    <bpmn:sequenceFlow id="Seq_6" sourceRef="Persist" targetRef="NewCommit"/>
    <bpmn:sequenceFlow id="Seq_7" sourceRef="NewCommit" targetRef="CommitResult" name="Identical retry: no new Ping"/>
    <bpmn:sequenceFlow id="Seq_8" sourceRef="NewCommit" targetRef="Fork" name="New message"/>
    <bpmn:sequenceFlow id="Seq_9" sourceRef="Fork" targetRef="CommitResult"/>
    <bpmn:sequenceFlow id="Seq_10" sourceRef="Fork" targetRef="Ping"/>
    <bpmn:sequenceFlow id="Seq_11" sourceRef="CommitResult" targetRef="CommitReturned"/>
    <bpmn:sequenceFlow id="Seq_12" sourceRef="Ping" targetRef="PingSent"/>
    <bpmn:sequenceFlow id="Seq_13" sourceRef="InboxRequest" targetRef="PureRead"/>
    <bpmn:sequenceFlow id="Seq_14" sourceRef="PureRead" targetRef="Batch"/>
    <bpmn:sequenceFlow id="Seq_15" sourceRef="Batch" targetRef="BatchReturned"/>
    <bpmn:sequenceFlow id="Seq_16" sourceRef="AckRequest" targetRef="Consume"/>
    <bpmn:sequenceFlow id="Seq_17" sourceRef="Consume" targetRef="AckResult"/>
    <bpmn:sequenceFlow id="Seq_18" sourceRef="AckResult" targetRef="AckReturned"/>
    <bpmn:sequenceFlow id="Seq_19" sourceRef="Outcome" targetRef="RecordOutcome"/>
    <bpmn:sequenceFlow id="Seq_20" sourceRef="RecordOutcome" targetRef="OutcomeDone"/>
    <bpmn:dataStoreReference id="Database" name="SurrealDB / durable state" dataStoreRef="EmbeddedStore"/>
    <bpmn:association id="Persist_Data" sourceRef="Persist" targetRef="Database" associationDirection="One"/>
    <bpmn:textAnnotation id="StateNote"><bpmn:text>Persisted message, accepted notice and consumed cursor are separate facts. None proves model processing or task execution.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="Process_Daemon" isExecutable="false">
    <bpmn:documentation>Recipient device / local daemon. Descriptive collaboration of current source behavior; runtime E2E is not claimed.</bpmn:documentation>
    <bpmn:startEvent id="ReceivePing" name="Receive WS Ping">
      <bpmn:outgoing>Seq_21</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_ReceivePing" messageRef="Message_Ping"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Socket" name="6. Submit metadata notice&#10;to exact live Claude socket">
      <bpmn:incoming>Seq_21</bpmn:incoming>
      <bpmn:outgoing>Seq_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Accepted" name="Locally accepted?">
      <bpmn:incoming>Seq_22</bpmn:incoming>
      <bpmn:outgoing>Seq_23</bpmn:outgoing>
      <bpmn:outgoing>Seq_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="PingAck" name="WS ping_ack&#10;submission only">
      <bpmn:incoming>Seq_23</bpmn:incoming>
      <bpmn:outgoing>Seq_25</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="AckDone" name="">
      <bpmn:incoming>Seq_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="PingFail" name="WS ping_fail&#10;leave notification pending">
      <bpmn:incoming>Seq_24</bpmn:incoming>
      <bpmn:outgoing>Seq_26</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="FailDone" name="">
      <bpmn:incoming>Seq_26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Seq_21" sourceRef="ReceivePing" targetRef="Socket"/>
    <bpmn:sequenceFlow id="Seq_22" sourceRef="Socket" targetRef="Accepted"/>
    <bpmn:sequenceFlow id="Seq_23" sourceRef="Accepted" targetRef="PingAck" name="Yes"/>
    <bpmn:sequenceFlow id="Seq_24" sourceRef="Accepted" targetRef="PingFail" name="No"/>
    <bpmn:sequenceFlow id="Seq_25" sourceRef="PingAck" targetRef="AckDone"/>
    <bpmn:sequenceFlow id="Seq_26" sourceRef="PingFail" targetRef="FailDone"/>
    <bpmn:textAnnotation id="Prerequisites"><bpmn:text>Preconditions: saved device token; accepted WS; current native actors registered by SessionStart / prompt hooks. No per-session config edits.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="RetryNote"><bpmn:text>Failure leaves the notification pending: retry 5-60s; replay after reconnect. Same notification ID may cause duplicate notices. WS Ping 30s / silence 4min.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="Process_Claude" isExecutable="false">
    <bpmn:documentation>Recipient device / Claude. Descriptive collaboration of current source behavior; runtime E2E is not claimed.</bpmn:documentation>
    <bpmn:startEvent id="Notice" name="Metadata notice&#10;not the body">
      <bpmn:outgoing>Seq_27</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_Notice" messageRef="Message_Notice"/>
    </bpmn:startEvent>
    <bpmn:sendTask id="Inbox" name="7. Load skill; MCP inbox&#10;with exact actor">
      <bpmn:incoming>Seq_27</bpmn:incoming>
      <bpmn:outgoing>Seq_28</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="ReceiveBatch" name="Receive unread batch">
      <bpmn:incoming>Seq_28</bpmn:incoming>
      <bpmn:outgoing>Seq_29</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_ReceiveBatch" messageRef="Message_Batch"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Read" name="8. Read returned batch">
      <bpmn:incoming>Seq_29</bpmn:incoming>
      <bpmn:outgoing>Seq_30</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Ack" name="9. MCP ack&#10;exact returned positions">
      <bpmn:incoming>Seq_30</bpmn:incoming>
      <bpmn:outgoing>Seq_31</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="ReceiveAck" name="ACK result">
      <bpmn:incoming>Seq_31</bpmn:incoming>
      <bpmn:outgoing>Seq_32</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_ReceiveAck" messageRef="Message_AckResult"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="Done" name="Batch acknowledged&#10;not proof of execution">
      <bpmn:incoming>Seq_32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Seq_27" sourceRef="Notice" targetRef="Inbox"/>
    <bpmn:sequenceFlow id="Seq_28" sourceRef="Inbox" targetRef="ReceiveBatch"/>
    <bpmn:sequenceFlow id="Seq_29" sourceRef="ReceiveBatch" targetRef="Read"/>
    <bpmn:sequenceFlow id="Seq_30" sourceRef="Read" targetRef="Ack"/>
    <bpmn:sequenceFlow id="Seq_31" sourceRef="Ack" targetRef="ReceiveAck"/>
    <bpmn:sequenceFlow id="Seq_32" sourceRef="ReceiveAck" targetRef="Done"/>
    <bpmn:textAnnotation id="HookNote"><bpmn:text>Missed notice? UserPromptSubmit retries registration and checks oldest unread metadata within 2s. It returns the same notice; empty checks are silent. Body retrieval still uses MCP.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_MessageDelivery">
    <bpmn:participant id="Pool_Codex" name="Sender device / Codex" processRef="Process_Codex"/>
    <bpmn:participant id="Pool_Broker" name="Server / MCP + broker + embedded database" processRef="Process_Broker"/>
    <bpmn:participant id="Pool_Daemon" name="Recipient device / local daemon" processRef="Process_Daemon"/>
    <bpmn:participant id="Pool_Claude" name="Recipient device / Claude" processRef="Process_Claude"/>
    <bpmn:messageFlow id="Msg_0" name="MCP send (body)" sourceRef="Send" targetRef="SendRequest"/>
    <bpmn:messageFlow id="Msg_1" name="MCP committed result" sourceRef="CommitResult" targetRef="Committed"/>
    <bpmn:messageFlow id="Msg_2" name="Authenticated device WS / metadata" sourceRef="Ping" targetRef="ReceivePing"/>
    <bpmn:messageFlow id="Msg_3" name="Local Unix socket / metadata" sourceRef="Socket" targetRef="Notice"/>
    <bpmn:messageFlow id="Msg_4" name="Accepted notice" sourceRef="PingAck" targetRef="Outcome"/>
    <bpmn:messageFlow id="Msg_5" name="Failed local submission" sourceRef="PingFail" targetRef="Outcome"/>
    <bpmn:messageFlow id="Msg_6" name="MCP inbox (no body in request)" sourceRef="Inbox" targetRef="InboxRequest"/>
    <bpmn:messageFlow id="Msg_7" name="MCP response / full bodies + ACK positions" sourceRef="Batch" targetRef="ReceiveBatch"/>
    <bpmn:messageFlow id="Msg_8" name="MCP ack (positions only)" sourceRef="Ack" targetRef="AckRequest"/>
    <bpmn:messageFlow id="Msg_9" name="MCP ACK result" sourceRef="AckResult" targetRef="ReceiveAck"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_MessageDelivery"><bpmndi:BPMNPlane id="Plane_MessageDelivery" bpmnElement="Collaboration_MessageDelivery">
    <bpmndi:BPMNShape id="Shape_Pool_Codex" bpmnElement="Pool_Codex" isHorizontal="true" bioc:fill="#eff6ff" bioc:stroke="#475569"><dc:Bounds x="60" y="70" width="2390" height="160"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Pool_Broker" bpmnElement="Pool_Broker" isHorizontal="true" bioc:fill="#f8fafc" bioc:stroke="#475569"><dc:Bounds x="60" y="280" width="2390" height="410"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Pool_Daemon" bpmnElement="Pool_Daemon" isHorizontal="true" bioc:fill="#f0fdfa" bioc:stroke="#475569"><dc:Bounds x="60" y="740" width="2390" height="230"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Pool_Claude" bpmnElement="Pool_Claude" isHorizontal="true" bioc:fill="#fff7ed" bioc:stroke="#475569"><dc:Bounds x="60" y="1020" width="2390" height="180"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Compose" bpmnElement="Compose" bioc:fill="#ffffff" bioc:stroke="#334155"><dc:Bounds x="140" y="130" width="36" height="36"/>
      <bpmndi:BPMNLabel><dc:Bounds x="105" y="171" width="106" height="38"/></bpmndi:BPMNLabel>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_StableId" bpmnElement="StableId" bioc:fill="#ffffff" bioc:stroke="#334155"><dc:Bounds x="220" y="113" width="160" height="70"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Send" bpmnElement="Send" bioc:fill="#ffffff" bioc:stroke="#334155"><dc:Bounds x="430" y="113" width="170" height="70"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Committed" bpmnElement="Committed" bioc:fill="#ffffff" bioc:stroke="#334155"><dc:Bounds x="700" y="130" width="36" height="36"/>
      <bpmndi:BPMNLabel><dc:Bounds x="665" y="171" width="106" height="38"/></bpmndi:BPMNLabel>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_SendDone" bpmnElement="SendDone" bioc:fill="#ffffff" bioc:stroke="#334155"><dc:Bounds x="820" y="130" width="36" height="36"/>
      <bpmndi:BPMNLabel><dc:Bounds x="785" y="171" width="106" height="38"/></bpmndi:BPMNLabel>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_SendRequest" bpmnElement="SendRequest" bioc:fill="#ffffff" bioc:stroke="#334155"><dc:Bounds x="300" y="330" width="36" height="36"/>
      <bpmndi:BPMNLabel><dc:Bounds x="265" y="371" width="106" height="38"/></bpmndi:BPMNLabel>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Authorize" bpmnElement="Authorize" bioc:fill="#ffffff" bioc:stroke="#334155"><dc:Bounds x="390" y="313" width="150" height="70"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Persist" bpmnElement="Persist" bioc:fill="#ffffff" bioc:stroke="#334155"><dc:Bounds x="590" y="303" width="190" height="90"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_NewCommit" bpmnElement="NewCommit" bioc:fill="#fef3c7" bioc:stroke="#334155"><dc:Bounds x="820" y="326" width="44" height="44"/>
      <bpmndi:BPMNLabel><dc:Bounds x="785" y="375" width="114" height="38"/></bpmndi:BPMNLabel>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Fork" bpmnElement="Fork" bioc:fill="#fef3c7" bioc:stroke="#334155"><dc:Bounds x="930" y="445" width="44" height="44"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_CommitResult" bpmnElement="CommitResult" bioc:fill="#ffffff" bioc:stroke="#334155"><dc:Bounds x="1040" y="308" width="170" height="70"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_CommitReturned" bpmnElement="CommitReturned" bioc:fill="#ffffff" bioc:stroke="#334155"><dc:Bounds x="1260" y="330" width="36" height="36"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Ping" bpmnElement="Ping" bioc:fill="#ffffff" bioc:stroke="#334155"><dc:Bounds x="1040" y="493" width="170" height="65"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_PingSent" bpmnElement="PingSent" bioc:fill="#ffffff" bioc:stroke="#334155"><dc:Bounds x="1260" y="510" width="36" height="36"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_InboxRequest" bpmnElement="InboxRequest" bioc:fill="#ffffff" bioc:stroke="#334155"><dc:Bounds x="1360" y="330" width="36" height="36"/>
      <bpmndi:BPMNLabel><dc:Bounds x="1325" y="371" width="106" height="38"/></bpmndi:BPMNLabel>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_PureRead" bpmnElement="PureRead" bioc:fill="#ffffff" bioc:stroke="#334155"><dc:Bounds x="1440" y="303" width="190" height="90"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Batch" bpmnElement="Batch" bioc:fill="#ffffff" bioc:stroke="#334155"><dc:Bounds x="1680" y="313" width="170" height="70"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_BatchReturned" bpmnElement="BatchReturned" bioc:fill="#ffffff" bioc:stroke="#334155"><dc:Bounds x="1900" y="330" width="36" height="36"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_AckRequest" bpmnElement="AckRequest" bioc:fill="#ffffff" bioc:stroke="#334155"><dc:Bounds x="1900" y="500" width="36" height="36"/>
      <bpmndi:BPMNLabel><dc:Bounds x="1865" y="541" width="106" height="38"/></bpmndi:BPMNLabel>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Consume" bpmnElement="Consume" bioc:fill="#ffffff" bioc:stroke="#334155"><dc:Bounds x="1980" y="483" width="180" height="70"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_AckResult" bpmnElement="AckResult" bioc:fill="#ffffff" bioc:stroke="#334155"><dc:Bounds x="2210" y="483" width="140" height="70"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_AckReturned" bpmnElement="AckReturned" bioc:fill="#ffffff" bioc:stroke="#334155"><dc:Bounds x="2390" y="500" width="36" height="36"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Outcome" bpmnElement="Outcome" bioc:fill="#ffffff" bioc:stroke="#334155"><dc:Bounds x="1360" y="610" width="36" height="36"/>
      <bpmndi:BPMNLabel><dc:Bounds x="1325" y="651" width="106" height="38"/></bpmndi:BPMNLabel>
